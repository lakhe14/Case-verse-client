# Browser-safe Vite configuration only. Never put secrets in VITE_* variables.
# Leave blank in development to use the Vite /api proxy.
VITE_API_URL=

# Public storefront contact details. Leave blank to hide the corresponding UI.
VITE_WHATSAPP_NUMBER=
VITE_WHATSAPP_GREETING=Hi CaseVerse
VITE_CONTACT_EMAIL=

# Fixed browser-safe sale expiry; leave blank to hide the countdown.
VITE_SALE_END_AT=
